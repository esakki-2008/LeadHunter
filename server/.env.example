PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
# Search provider: demo or osm
SEARCH_PROVIDER=osm
OSM_SEARCH_RADIUS_METERS=7000
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Replace with an identifying user agent/contact before production use.
OSM_USER_AGENT=LeadHunterAI/0.1 (your-contact)
